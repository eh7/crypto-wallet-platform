<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Example EJS Template File</h1>
    <h2><%= now %></h2>
    <h2><%= msg %></h2>
    <% Object.keys(data).forEach(function(timestamp, i) { %>
      <% if (i < 10) { %>
        <% const date = new Date(timestamp); %><br>
        <%= timestamp %><br>
	<%= data[timestamp].symbol %><br>
	<%= data[timestamp].quote['USD'].price %><br>
      <% } %>
    <% }) %>
    <textarea rows=10 cols=100><%= JSON.stringify(data, null, 4) %></textarea>
    <%= Object.keys(data) %>
</body>
</html>
