<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Example Chart</h1>
    <h2><%= now %></h2>
    <h2><%= msg %></h2>

<div>
  <canvas id="myChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const ctx = document.getElementById('myChart');

  const chartPriceData = "<%= chartPriceData %>".split(',')
  const sma5 = "<%= sma5 %>".split(',')
  const ema5 = "<%= ema5 %>".split(',')
  const sma24 = "<%= sma24 %>".split(',')
  const ema24 = "<%= ema24 %>".split(',')
  const labels = "<%= labels %>".split(',')

//  console.log('take 2 :: ', sma5) 
//  console.log('take 2 :: ', chartPriceData) 
//  console.log('take 3 :: ', labels) 

  new Chart(ctx, {
    data: {
      datasets: [
        {
          type: 'line',
          label: 'ETH $',
          data: chartPriceData,
          pointRadius: 1,
          pointHoverRadius: 1,
        },
        {
          type: 'line',
          label: 'sma5',
          data: sma5,
          pointRadius: 1,
          pointHoverRadius: 1,
        },
        {
          type: 'line',
          label: 'ema5',
          data: ema5,
          pointRadius: 1,
          pointHoverRadius: 1,
        },
        {
          type: 'line',
          label: 'sma24',
          data: sma24,
          pointRadius: 1,
          pointHoverRadius: 1,
        },
        {
          type: 'line',
          label: 'ema24',
          data: ema24,
          pointRadius: 1,
          pointHoverRadius: 1,
        },
      ],
      labels,
    },
    options: {
  elements: {
    point: {
      radius: 1,
      hoverRadius: 1, // ex.: to make it bigger when user hovers put larger number than radius.
    }
  }
    }
  })

